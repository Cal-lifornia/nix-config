    spawn-at-startup "noctalia"
    spawn-at-startup "kitty" 
    spawn-at-startup "helium" "--password-store=kwallet5"
    spawn-at-startup "discord"
    spawn-at-startup "env" "DESKTOPINTEGRATION=1" "/home/whobson/AppImages/sidra.appimage" "--no-sandbox"
